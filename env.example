# Keke - environment configuration
#
# Copy to .env and edit:  cp env.example .env
#
# This file is loaded at startup by api/server.js (dotenv). The Python helpers
# inherit the same environment when spawned, so one file configures everything.
# Variables that are already set in the real environment take precedence and are
# not overridden here.
#
# Every variable below is read by the code. Nothing is aspirational.

# =============================================================================
# SERVER
# =============================================================================

# HTTP port. Read by api/server.js.
PORT=3000

# Comma-separated allowed CORS origins. Read by api/server.js.
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS=http://localhost:3000

# Hard deadline in milliseconds for every spawned Python helper. Exceeding it
# SIGKILLs the interpreter so a wedged pandas call cannot hold a request open.
# Read by api/python_runner.js. Default: 120000
PYTHON_TIMEOUT_MS=120000

# =============================================================================
# UPLOADS AND SESSIONS
# =============================================================================

# Maximum upload size in bytes. Exceeding it returns HTTP 413.
# Read by api/api_routes.js. Default: 52428800 (50MB)
MAX_FILE_SIZE=52428800

# Where uploaded files and session metadata are stored. Read by both
# api/api_routes.js and api/session_store.py - they must agree.
# Default: <repo>/data/sessions
# KEKE_SESSION_DIR=data/sessions

# Unix socket used by the FreeRTOS bridge daemon. Read by api/rtos_bridge.py.
# Default: <repo>/data/rtos_bridge.sock
# KEKE_RTOS_SOCKET=data/rtos_bridge.sock

# =============================================================================
# AI (optional - off by default)
# =============================================================================
#
# When AI_ENABLED is not "true" every /api/ai/* route answers 503 and no
# network calls are made. Set an API key to use the endpoints.

# Master switch for the /api/ai/* routes. Read by api/api_routes.js.
AI_ENABLED=false

# Used by api/assistant.py and api/ml_processor.py. Either key is enough;
# the provider is chosen by whichever is set.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# =============================================================================
# CLOUD STORAGE (optional)
# =============================================================================
#
# Used by the /api/cloud/* routes (api/cloud_storage.py). The /api/cloud/status
# route reports which providers are configured.
#
# --- AWS S3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# --- Google Drive ---
# GOOGLE_DRIVE_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# --- Dropbox ---
# DROPBOX_TOKEN=
