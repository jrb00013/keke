# Copy to secrets.yaml and fill in values before applying.
# Do not commit secrets.yaml with real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: keke-secrets
  namespace: keke
type: Opaque
stringData:
  JWT_SECRET: change-me
  ENCRYPTION_KEY: change-me
  DATABASE_URL: postgresql://postgres:password@postgres:5432/keke
  REDIS_URL: redis://redis:6379
