# Template for the `keke-secrets` Secret consumed by the workloads in this
# directory.
#
# Copy to secrets.yaml, fill in real values, and apply it out-of-band (it is
# intentionally NOT committed and NOT applied by CI):
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml
#   kubectl apply -f secrets.yaml
#
# Every key below is referenced by a workload. A key that is missing here but
# required by a pod will surface as CreateContainerConfigError.
apiVersion: v1
kind: Secret
metadata:
  name: keke-secrets
  namespace: keke
type: Opaque
stringData:
  # Application auth / encryption
  JWT_SECRET: change-me
  ENCRYPTION_KEY: change-me

  # AI providers (referenced by k8s/deployment.yaml)
  OPENAI_API_KEY: change-me
  ANTHROPIC_API_KEY: change-me

  # Datastore passwords (referenced by k8s/database-deployments.yaml)
  POSTGRES_PASSWORD: change-me
  MONGODB_PASSWORD: change-me
